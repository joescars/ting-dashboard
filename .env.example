# Copy to .env (gitignored). Only DASHBOARD_PASSWORD is strongly recommended;
# everything else has a sane default.

# Password for the web UI. Leave blank only on a trusted LAN — the dashboard is
# open to anyone who can reach the port when this is empty. scripts/setup.sh
# generates one for you.
DASHBOARD_PASSWORD=

# Ting account. Both optional: you can link the account in the browser at
# /setup using the one-time code printed in the container log. If you do fill
# these in, the password is used once for the Cognito sign-in and is never
# written to disk — only a refresh token is stored (./data/auth.json, 0600).
TING_EMAIL=
TING_PASSWORD=

# Pin the /setup code instead of using the generated one (rarely needed)
# SETUP_TOKEN=

# Host port, and the uid/gid the container runs as (must own ./data)
TING_PORT=8097
# TING_UID=1000
# TING_GID=1000

# Seconds between status polls (min 30)
TING_POLL_INTERVAL=60
# Seconds between alert-history fetches (min 60)
TING_NOTIFICATION_INTERVAL=300
# Voltage history resolution in seconds
TING_BUCKET_SECONDS=5
# Days of voltage history kept in SQLite
TING_RETENTION_DAYS=90

# 1 = synthetic data, no account needed
TING_DEMO=0
LOG_LEVEL=INFO
