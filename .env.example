# Copy to .env (gitignored) and fill in. Only used for the first sign-in:
# the service stores a Cognito refresh token in ./data/auth.json (0600) and
# never writes the password. After the first successful start you can delete
# TING_PASSWORD from .env. Alternative (no password in .env at all):
#   docker compose run --rm ting python -m app.login
TING_EMAIL=
TING_PASSWORD=

# Host port for the dashboard
TING_PORT=8097

# Seconds between status polls (min 30)
TING_POLL_INTERVAL=60
# Seconds between alert-history fetches (min 60)
TING_NOTIFICATION_INTERVAL=300
# Voltage history resolution in seconds
TING_BUCKET_SECONDS=5
# Days of voltage history kept in SQLite
TING_RETENTION_DAYS=90
# 1 = synthetic data, no account needed
TING_DEMO=0
LOG_LEVEL=INFO
